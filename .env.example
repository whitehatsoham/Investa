# Investa — environment settings
#
# Copy this file to `.env` and paste your own key in. `.env` is gitignored,
# so your key stays on your machine and never reaches GitHub.
#
#     cp .env.example .env
#
# A free key takes about 30 seconds to get:
#     https://www.alphavantage.co/support/#api-key
#
# The free tier allows 25 API calls per day. A full price refresh across all
# 18 tickers uses 18 of them, so plan on refreshing once a day.

ALPHAVANTAGE_API_KEY=your_key_here
